# --- Security & Secrets (CRITICAL) ---
# Never push these! They contain your passwords and API keys.
.env
credentials.json
token.json
*.pem
*.key

# --- Python & Virtual Environments ---
# Don't upload the thousands of library files in your venv.
.venv/
env/
venv/
ENV/
bin/
lib/
develop-eggs/
dist/
eggs/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Caches & Temporary Files ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.cache/
.mypy_cache/
.ruff_cache/

# --- Project Specific (SortyX) ---
# Ignore the actual resumes, but keep the folder structure.
# (Requires an empty file named .gitkeep inside the uploads folder)
uploads/*
!uploads/.gitkeep

# --- Database ---
# If you ever use a local SQLite file for testing.
*.sqlite3
*.db

# --- Logs ---
*.log
logs/

